#!/usr/bin/env bash
# Lightweight host snapshot for the MediaHub production server. It runs under
# systemd every minute and is deliberately independent of Rails, FFmpeg and
# the GPU workers so it can preserve evidence when one of those fails.

set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LOG_DIR=/var/log/mediahub
LOG_FILE="$LOG_DIR/host-monitor.log"
TAG=mediahub-host-monitor

mkdir -p "$LOG_DIR"

now=$(date --iso-8601=seconds)
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || printf unknown)
read -r load_1 load_5 load_15 _ < /proc/loadavg
mem_available_kb=$(awk '/MemAvailable:/ { print $2 }' /proc/meminfo)
mem_available_mb=$((mem_available_kb / 1024))
root_usage=$(df -P / | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }')
opt_usage=$(df -P /opt | awk 'NR == 2 { gsub(/%/, "", $5); print $5 }')
failed_units=$(systemctl --failed --no-legend 2>/dev/null | awk 'NF { count += 1 } END { print count + 0 }')
listeners=$(systemctl list-units 'mediahub-listener@*.service' --state=running --no-legend 2>/dev/null | awk 'NF { count += 1 } END { print count + 0 }')
rails_state=$(systemctl is-active mediahub-web.service 2>/dev/null || true)

gpu=unavailable
gpu_temperature=0
gpu_memory_percent=0
if command -v nvidia-smi >/dev/null 2>&1; then
  gpu=$(timeout 10 nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw --format=csv,noheader,nounits 2>/dev/null | head -1 || true)
  if [[ -n "$gpu" ]]; then
    IFS=',' read -r gpu_util gpu_memory_used gpu_memory_total gpu_temperature gpu_power <<< "$gpu"
    gpu_memory_used=${gpu_memory_used// /}
    gpu_memory_total=${gpu_memory_total// /}
    if [[ "$gpu_memory_used" =~ ^[0-9]+$ && "$gpu_memory_total" =~ ^[0-9]+$ ]] && (( gpu_memory_total > 0 )); then
      gpu_memory_percent=$((gpu_memory_used * 100 / gpu_memory_total))
    fi
  fi
fi

# Count recent process crashes without keeping a long-running process around.
recent_cores=$(timeout 10 coredumpctl --no-pager --no-legend list --since '2 minutes ago' 2>/dev/null | awk 'NF { count += 1 } END { print count + 0 }')

snapshot="ts=$now boot_id=$boot_id load=$load_1,$load_5,$load_15 mem_available_mb=$mem_available_mb root_used_pct=$root_usage opt_used_pct=$opt_usage rails=$rails_state listeners=$listeners failed_units=$failed_units recent_cores=$recent_cores gpu=\"$gpu\""
printf '%s\n' "$snapshot" >> "$LOG_FILE"
logger -t "$TAG" -- "$snapshot"

warnings=()
if (( mem_available_mb < 8192 )); then warnings+=("low_memory"); fi
if (( root_usage >= 85 )); then warnings+=("root_disk_high"); fi
if (( opt_usage >= 85 )); then warnings+=("media_disk_high"); fi
if [[ "$rails_state" != "active" ]]; then warnings+=("rails_not_active"); fi
if (( failed_units > 0 )); then warnings+=("failed_units=$failed_units"); fi
if (( recent_cores > 0 )); then warnings+=("recent_cores=$recent_cores"); fi
if [[ "$gpu_temperature" =~ ^[0-9]+$ ]] && (( gpu_temperature >= 85 )); then warnings+=("gpu_hot"); fi
if (( gpu_memory_percent >= 90 )); then warnings+=("gpu_memory_high"); fi

if (( ${#warnings[@]} > 0 )); then
  logger -p daemon.warning -t "$TAG" -- "warning=${warnings[*]} $snapshot"
fi
