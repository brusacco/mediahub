<% content_for :extra_stylesheets do %>
  <style>.highcharts-grid-line { stroke: #e2e8f0 !important; stroke-width: 1px !important; }</style>
<% end %>

<% topic_summaries = @topicos.map do |topic| %>
  <% videos = topic.list_videos %>
  <% { topic: topic, videos: videos, clips: videos.count, stations: videos.distinct.count(:station_id), tags: topic.tags.count } %>
<% end %>
<% total_clips = topic_summaries.sum { |summary| summary[:clips] } %>
<% total_stations = topic_summaries.sum { |summary| summary[:stations] } %>

<div class="dashboard-shell">
  <section class="dashboard-hero">
    <div class="dashboard-container dashboard-hero__content">
      <div class="dashboard-hero__copy">
        <div class="eyebrow eyebrow--light"><span class="live-dot" aria-hidden="true"></span>Centro de monitoreo</div>
        <h1>La conversación pública,<br><span>en contexto.</span></h1>
        <p>Seguimiento editorial de señales, clips y temas relevantes en una sola vista.</p>
      </div>
      <div class="dashboard-hero__status" aria-label="Resumen del monitoreo">
        <span class="status-label">Ventana de análisis</span>
        <strong>Últimos <%= DAYS_RANGE %> días</strong>
        <span class="status-meta"><i class="fa-regular fa-clock" aria-hidden="true"></i> Actualizado con cada nueva captura</span>
      </div>
    </div>
  </section>

  <main class="dashboard-main">
    <div class="dashboard-container">
      <section class="metric-grid" aria-label="Resumen operativo">
        <article class="metric-card"><span class="metric-card__icon metric-card__icon--indigo"><i class="fa-solid fa-layer-group"></i></span><div><span class="metric-card__label">Temas monitoreados</span><strong><%= number_with_delimiter(@topicos.count) %></strong></div></article>
        <article class="metric-card"><span class="metric-card__icon metric-card__icon--sky"><i class="fa-solid fa-play"></i></span><div><span class="metric-card__label">Clips relevantes</span><strong><%= number_with_delimiter(total_clips, delimiter: ".") %></strong></div></article>
        <article class="metric-card"><span class="metric-card__icon metric-card__icon--emerald"><i class="fa-solid fa-tower-broadcast"></i></span><div><span class="metric-card__label">Señales con hallazgos</span><strong><%= number_with_delimiter(total_stations) %></strong></div></article>
        <article class="metric-card metric-card--quiet"><span class="metric-card__icon metric-card__icon--slate"><i class="fa-solid fa-calendar-day"></i></span><div><span class="metric-card__label">Período activo</span><strong><%= DAYS_RANGE %> días</strong></div></article>
      </section>

      <section class="dashboard-section" aria-labelledby="topics-heading">
        <div class="section-heading"><div><span class="eyebrow">Seguimiento personalizado</span><h2 id="topics-heading">Temas en monitoreo</h2><p>Accedé a los hallazgos, fuentes y evolución de cada tema.</p></div><span class="section-count"><%= @topicos.count %> activos</span></div>
        <% if topic_summaries.any? %>
          <div class="topic-grid">
            <% topic_summaries.each do |summary| %>
              <% topic = summary[:topic] %>
              <article class="topic-card">
                <div class="topic-card__header"><span class="topic-card__marker"><i class="fa-solid fa-chart-line"></i></span><span class="topic-card__eyebrow">Tema activo</span></div>
                <h3><%= topic.name %></h3>
                <dl class="topic-card__metrics"><div><dt>Clips</dt><dd><%= number_with_delimiter(summary[:clips], delimiter: ".") %></dd></div><div><dt>Señales</dt><dd><%= number_with_delimiter(summary[:stations]) %></dd></div><div><dt>Etiquetas</dt><dd><%= number_with_delimiter(summary[:tags]) %></dd></div></dl>
                <%= link_to topic_path(topic), class: "topic-card__link" do %>Explorar análisis <i class="fa-solid fa-arrow-right"></i><% end %>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state"><span class="empty-state__icon"><i class="fa-solid fa-compass"></i></span><h3>Aún no tenés temas asignados</h3><p>Cuando se active un tema de monitoreo, sus clips y análisis aparecerán aquí.</p></div>
        <% end %>
      </section>

      <section class="dashboard-section dashboard-section--muted" aria-labelledby="insights-heading">
        <div class="section-heading"><div><span class="eyebrow">Panorama</span><h2 id="insights-heading">Evolución de la cobertura</h2><p>Volumen de hallazgos y distribución reciente por tema.</p></div></div>
        <div class="insight-grid">
          <article class="insight-card"><div class="insight-card__heading"><h3>Clips por día</h3><span>Histórico</span></div><%= line_chart @video_quantities, xtitle: "Fecha", ytitle: "Clips", thousands: ".", curve: false, adapter: "highcharts", library: { chart: { backgroundColor: "transparent" }, plotOptions: { series: { dataLabels: { enabled: false } } } } %></article>
          <article class="insight-card"><div class="insight-card__heading"><h3>Últimas 24 horas</h3><span>Por tema</span></div><%= bar_chart @videos_last_day_topics, xtitle: "Tema", ytitle: "Clips", thousands: ".", adapter: "highcharts", library: { chart: { backgroundColor: "transparent" }, plotOptions: { series: { dataLabels: { enabled: false } } } } %></article>
        </div>
      </section>

      <section class="dashboard-section" aria-labelledby="words-heading">
        <div class="section-heading"><div><span class="eyebrow">Lenguaje predominante</span><h2 id="words-heading">Palabras que marcan la agenda</h2><p>Términos más frecuentes dentro de los clips relevantes recientes.</p></div></div>
        <div class="word-cloud-card">
          <% if @word_occurrences.present? %>
            <% min_max = find_max_and_min_occurrences(@word_occurrences) %>
            <ul class="cloud" aria-label="Nube de palabras"><% @word_occurrences.shuffle { |a, b| a[1] <=> b[1] }.each do |word, value| %><li data-weight="<%= normalize_to_scale(value, min_max[:max], min_max[:min]) %>"><%= word %></li><% end %></ul>
          <% else %><p class="word-cloud-card__empty">Todavía no hay suficiente texto procesado para mostrar tendencias.</p><% end %>
        </div>
      </section>

      <section class="dashboard-section dashboard-section--clips" aria-labelledby="recent-heading">
        <div class="section-heading"><div><span class="eyebrow">Archivo reciente</span><h2 id="recent-heading">Últimos hallazgos</h2><p>Clips relevantes organizados por tema de interés.</p></div></div>
        <div class="recent-topic-groups"><% topic_summaries.each do |summary| %><% next if summary[:videos].empty? %><%= render partial: "videos/videos", locals: { last_videos: summary[:videos].limit(12), title: summary[:topic].name } %><% end %></div>
      </section>
    </div>
  </main>
</div>
