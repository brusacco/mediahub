<% content_for :extra_stylesheets do %>
  <link href="https://cdn.datatables.net/v/dt/jq-3.7.0/dt-2.1.6/datatables.min.css" rel="stylesheet">
<% end %>

<% content_for :extra_javascripts do %>
  <script src="https://cdn.datatables.net/v/dt/jq-3.7.0/dt-2.1.6/datatables.min.js"></script>
<% end %>

<section class="video-table mb-8" aria-labelledby="videos-table-title">
  <header class="video-table__header">
    <div>
      <span class="eyebrow">Archivo audiovisual</span>
      <h2 id="videos-table-title"><%= title %></h2>
    </div>
    <span class="video-table__count"><i class="fa-solid fa-film" aria-hidden="true"></i> <%= number_with_delimiter(videos.count, delimiter: ".") %> clips</span>
  </header>

  <div class="video-table__panel">
    <div class="video-table__scroll" data-controller="datatable">
      <table id="videos-table" class="videos-datatable video-table__data display" style="width:100%">
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Vista previa</th>
            <th scope="col">Transcripción</th>
            <th scope="col">Etiquetas</th>
            <th scope="col">Señal</th>
          </tr>
        </thead>
        <tbody>
          <% videos.each do |video| %>
            <tr>
              <td class="video-table__date" data-sort="<%= video.posted_at.strftime('%Y%m%d%H%M%s') %>">
                <time datetime="<%= video.posted_at.iso8601 %>"><%= video.posted_at.strftime('%d %b %Y') %></time>
                <span><%= video.posted_at.strftime('%H:%M') %></span>
              </td>
              <td class="video-table__preview">
                <%= link_to video_path(video), class: "video-table__thumbnail", aria: { label: "Abrir clip de #{video.station.name}" } do %>
                  <% if video.thumbnail_path.present? %>
                    <%= image_tag "/#{video.thumbnail_path}", loading: "lazy", alt: "Vista previa de #{video.station.name}", onerror: "this.remove();this.parentElement.classList.add('video-table__thumbnail--missing');" %>
                  <% end %>
                  <span class="video-table__play"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
                <% end %>
              </td>
              <td class="video-table__transcript">
                <%= link_to video_path(video), class: "video-table__transcript-link" do %>
                  <% if video.transcription.present? %>
                    <% if video.tag_list.present? %>
                      <%= highlight(video.transcription, video.all_tags_boundarys) %>
                    <% else %>
                      <%= video.transcription %>
                    <% end %>
                  <% else %>
                    <span class="video-table__pending">Transcripción pendiente</span>
                  <% end %>
                <% end %>
              </td>
              <td class="video-table__tags">
                <% if video.tag_list.present? %>
                  <div class="video-table__tag-list">
                    <% video.tag_list.first(4).each do |tag| %><span><%= tag %></span><% end %>
                    <% if video.tag_list.count > 4 %><span class="video-table__tag-more">+<%= video.tag_list.count - 4 %></span><% end %>
                  </div>
                <% else %>
                  <span class="video-table__muted">Sin etiquetas</span>
                <% end %>
              </td>
              <td class="video-table__station">
                <%= link_to station_path(video.station), class: "video-table__station-link" do %>
                  <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i><span><%= video.station.name %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
