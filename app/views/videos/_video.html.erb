<article class="video-card group">
  <!-- Thumbnail -->
  <div class="video-card__media aspect-video w-full overflow-hidden bg-slate-100">
    <%= link_to video_path(video), class: 'block h-full w-full' do %>
      <%= image_tag("/#{video.thumbnail_path}", loading: 'lazy', class: 'h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500', onerror: 'this.closest(".video-card__media").classList.add("video-card__media--missing");this.remove();') %>
      <!-- Play Overlay -->
      <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all duration-300">
        <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <i class="fa-regular fa-circle-play text-white text-4xl"></i>
        </div>
      </div>
    <% end %>
  </div>
  
  <!-- Video Info -->
  <div class="video-card__body">
    <div class="flex items-center justify-between mb-2">
      <h3 class="text-sm font-semibold text-slate-900 truncate flex items-center gap-2">
        <i class="fa-solid fa-tower-broadcast text-indigo-600"></i>
        <span class="truncate"><%= video.station.name %></span>
      </h3>
    </div>
    <div class="flex items-center text-xs text-slate-500 mb-3">
      <i class="fa-regular fa-calendar mr-2"></i>
      <span><%= video.posted_at.strftime('%d-%m-%Y %H:%M') %></span>
    </div>
    <% if video.all_tags.any? %>
      <div class="flex flex-wrap gap-1">
        <% video.all_tags.first(3).each do |tag| %>
          <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
            <%= tag %>
          </span>
        <% end %>
        <% if video.all_tags.count > 3 %>
          <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-500">
            +<%= video.all_tags.count - 3 %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
