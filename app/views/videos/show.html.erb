<% content_for :extra_stylesheets do %>
  <style>.scrollbar-hide::-webkit-scrollbar { display:none; }.scrollbar-hide { -ms-overflow-style:none; scrollbar-width:none; }</style>
<% end %>

<header class="detail-hero clip-hero">
  <div class="dashboard-container py-8">
    <div class="clip-hero__content">
      <div>
        <div class="eyebrow eyebrow--light"><span class="live-dot" aria-hidden="true"></span>Archivo audiovisual</div>
        <h1><%= @clip.station.name %></h1>
        <p>Clip registrado el <time datetime="<%= @clip.posted_at.iso8601 %>"><%= @clip.posted_at.strftime('%d/%m/%Y, %H:%M:%S') %></time></p>
      </div>
      <a href="<%= @clip_path %>" download data-turbo="false" class="clip-hero__download"><i class="fa-solid fa-download" aria-hidden="true"></i> Descargar clip</a>
    </div>
  </div>
</header>

<%= render "shared/breadcrumbs", items: [
  { label: "Inicio", path: root_path, icon: "fa-solid fa-home" },
  { label: "Clips", path: nil },
  { label: @clip.station.name, path: station_path(@clip.station) },
  { label: @clip.posted_at.strftime('%d/%m %H:%M'), path: nil, current: true }
] %>

<main class="detail-page clip-page">
  <div class="dashboard-container py-8 lg:py-10">
    <div class="clip-layout">
      <div class="clip-primary">
        <section class="clip-player-card" aria-label="Reproductor de video">
          <div class="clip-player-card__video">
            <video controls preload="metadata" poster="<%= "/#{@clip.thumbnail_path}" if @clip.thumbnail_path.present? %>">
              <source src="<%= @clip_path %>" type="video/mp4">
              Tu navegador no soporta la reproducción de este video.
            </video>
          </div>
          <div class="clip-player-card__caption">
            <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= @clip.posted_at.strftime('%d/%m/%Y · %H:%M:%S') %></span>
            <%= link_to station_path(@clip.station) do %><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> <%= @clip.station.name %><% end %>
          </div>
        </section>

        <section class="clip-transcript" aria-labelledby="transcript-heading">
          <header class="clip-section-heading">
            <div><span class="eyebrow">Contenido procesado</span><h2 id="transcript-heading">Transcripción</h2></div>
            <% if @clip.transcription.present? %><span class="clip-status clip-status--ready"><i class="fa-solid fa-check" aria-hidden="true"></i> Disponible</span><% else %><span class="clip-status"><i class="fa-solid fa-clock" aria-hidden="true"></i> Pendiente</span><% end %>
          </header>
          <% if @clip.transcription.present? %>
            <div class="clip-transcript__body">
              <% if @clip.tag_list.present? %><%= highlight(@clip.transcription, @clip.all_tags_boundarys) %><% else %><%= @clip.transcription %><% end %>
            </div>
          <% else %>
            <p class="clip-empty">Este clip todavía no tiene una transcripción disponible.</p>
          <% end %>
        </section>

        <% if @related_videos.length > 1 %>
          <section class="clip-timeline" data-controller="film-strip" aria-labelledby="timeline-heading">
            <header class="clip-section-heading"><div><span class="eyebrow">Contexto de emisión</span><h2 id="timeline-heading">Secuencia de la señal</h2></div><span class="clip-timeline__hint">± 3 clips</span></header>
            <div data-film-strip-target="container" class="clip-timeline__rail scrollbar-hide">
              <% @related_videos.each do |video| %>
                <% is_current = video.id == @clip.id %>
                <%= link_to video_path(video), class: "clip-timeline__item #{'clip-timeline__item--current' if is_current}", data: { turbo: false }, aria: { current: ("page" if is_current) } do %>
                  <span class="clip-timeline__image">
                    <% if video.thumbnail_path.present? %><%= image_tag "/#{video.thumbnail_path}", loading: "lazy", alt: "Clip de #{video.station.name}" %><% end %>
                    <% if is_current %><span>Actual</span><% end %>
                  </span>
                  <span class="clip-timeline__time"><%= video.posted_at.strftime('%H:%M:%S') %></span>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <aside class="clip-sidebar" aria-label="Contexto del clip">
        <section class="clip-context-card">
          <span class="eyebrow">Ficha del clip</span>
          <dl>
            <div><dt>Señal</dt><dd><%= link_to @clip.station.name, station_path(@clip.station) %></dd></div>
            <div><dt>Emisión</dt><dd><time datetime="<%= @clip.posted_at.iso8601 %>"><%= @clip.posted_at.strftime('%d/%m/%Y') %><br><span><%= @clip.posted_at.strftime('%H:%M:%S') %></span></time></dd></div>
            <div><dt>ID</dt><dd>#<%= @clip.id %></dd></div>
          </dl>
        </section>

        <section class="clip-context-card">
          <header class="clip-card-title"><i class="fa-solid fa-tags" aria-hidden="true"></i><h2>Etiquetas</h2></header>
          <% if @clip.tags.any? %>
            <div class="clip-tag-list"><% @clip.tags.each do |tag| %><%= link_to tag.name, tag_path(tag) %><% end %></div>
          <% else %><p class="clip-empty">No hay etiquetas asignadas.</p><% end %>
        </section>

        <section class="clip-context-card">
          <header class="clip-card-title"><i class="fa-solid fa-closed-captioning" aria-hidden="true"></i><h2>Texto en pantalla</h2></header>
          <% if @clip.ocr_text.present? %><p class="clip-ocr"><%= @clip.ocr_text %></p><% else %><p class="clip-empty">No se detectó texto de zócalo en esta captura.</p><% end %>
        </section>
      </aside>
    </div>
  </div>
</main>
